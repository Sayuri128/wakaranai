<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/smt.sqlite" />
        <include domain="root" path="app_flutter/smt.sqlite-wal" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
