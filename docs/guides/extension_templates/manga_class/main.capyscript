import "http";
import "json";
import "html";
import "converter";
import "preferences";
import "errors";
import "manga_models";

class Extension extends MangaSource {
    baseUrl: string;

    function constructor() {
        this.baseUrl = "https://example.com";
    }

    override function getGallery(page, query, filters, feed, pageSize) {
        response = this.checkResponse(httpGet(this.baseUrl + "/list?page=" + parseString(page)), "gallery");
        return [];
    }

    override function getConcrete(uid, data) {
    }

    override function getPages(uid, data) {
    }

    override function getImageHeaders(uid, data) {
        return {"Referer": this.baseUrl + "/"};
    }
}
